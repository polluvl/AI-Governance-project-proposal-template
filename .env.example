# Copy this file to .env and fill in your values. .env is ignored by git — never commit real keys.
#
# Any OpenAI-compatible API works. Examples:
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1   (LLM_API_KEY can be any text)
#
# Leave LLM_MODEL empty to run the offline "mock" model (no API needed).

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
